-- ==============================
-- PALLET DETECTION
-- ==============================
local function isPallet(inst)
	if not inst then return false end
	if not inst:IsA("Model") then return false end

	if lower(inst.Name) ~= "palletwrong" then
		return false
	end

	return inst:FindFirstChild("HumanoidRootPart") ~= nil
end

-- ==============================
-- CREATE ESP
-- ==============================
local function mark(inst)
	if not enabled then return end
	if not inst or not inst.Parent then return end
	if highlights[inst] then return end
	if not isPallet(inst) then return end

	pcall(function()
		local hl = Instance.new("Highlight")
		hl.Name = "PalletESP"
		hl.Adornee = inst
		hl.FillColor = neonGreen
		hl.OutlineColor = neonGreen
		hl.FillTransparency = 0.5
		hl.OutlineTransparency = 0
		hl.Parent = inst

		highlights[inst] = hl
	end)
end

-- ==============================
-- ATTACH WATCHER
-- ==============================
local function attach(container)
	-- initial scan
	pcall(function()
		for _, d in ipairs(container:GetDescendants()) do
			mark(d)
		end
	end)

	-- add
	addConn(container.DescendantAdded:Connect(function(d)
		mark(d)
	end))

	-- remove (AUTO DESTROY ESP)
	addConn(container.DescendantRemoving:Connect(function(d)
		local hl = highlights[d]
		if hl then
			hl:Destroy()
			highlights[d] = nil
		end
	end))
end

-- ==============================
-- WATCHDOG (ANTI BUG / SAFE)
-- ==============================
local function startWatchdog()
	local acc = 0
	addConn(RunService.Heartbeat:Connect(function(dt)
		if not enabled then return end
		acc += dt
		if acc < 3 then return end
		acc = 0

		for inst, hl in pairs(highlights) do
			if not inst.Parent then
				if hl then hl:Destroy() end
				highlights[inst] = nil
			end
		end
	end))
end

