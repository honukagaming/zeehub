local Players = game:GetService("Players")
local RunService = game:GetService("RunService")
local UserInputService = game:GetService("UserInputService")

local LocalPlayer = Players.LocalPlayer
local Camera = workspace.CurrentCamera

-- Config
local FlyEnabled = false
local FlySpeed = 60
local VerticalSpeed = 45

-- Internal
local bv, bg, rsConn
local keys = {Up=false, Down=false}
local controlModule
local inputDebounce = false -- debounce untuk input

local function getChar()
	return LocalPlayer.Character
end

local function getHumanoid()
	local char = getChar()
	return char and char:FindFirstChildWhichIsA("Humanoid")
end

local function getRoot()
	local char = getChar()
	return char and char:FindFirstChild("HumanoidRootPart")
end

local function ensureControlModule()
	if controlModule then return end
	local ps = LocalPlayer:WaitForChild("PlayerScripts")
	local pm = ps:WaitForChild("PlayerModule")
	controlModule = require(pm:WaitForChild("ControlModule"))
end

local function cleanup()
	if rsConn then rsConn:Disconnect(); rsConn = nil end
	pcall(function() if bv then bv:Destroy(); bv = nil end end) -- safe destroy
	pcall(function() if bg then bg:Destroy(); bg = nil end end)

	local hum = getHumanoid()
	if hum then hum.PlatformStand = false end
end

local function startFly()
	cleanup()

	local root = getRoot()
	local hum = getHumanoid()
	if not root or not hum then return end

	ensureControlModule()
	hum.PlatformStand = true

	bv = Instance.new("BodyVelocity")
	bv.MaxForce = Vector3.new(1e9, 1e9, 1e9)
	bv.Velocity = Vector3.zero
	bv.Parent = root

	bg = Instance.new("BodyGyro")
	bg.MaxTorque = Vector3.new(1e9, 1e9, 1e9)
	bg.P = 9e4
	bg.CFrame = root.CFrame
	bg.Parent = root

	rsConn = RunService.RenderStepped:Connect(function()
		pcall(function() -- Error handling untuk mencegah crash
			local root2 = getRoot()
			local hum2 = getHumanoid()
			if not root2 or not hum2 or not bv or not bg then
				return
			end

			-- Move vector from Roblox ControlModule (works for keyboard + mobile thumbstick)
			local move = controlModule and controlModule:GetMoveVector() or Vector3.zero

			-- Skip update jika tidak ada input (optimasi performa)
			if move.Magnitude == 0 and not keys.Up and not keys.Down then
				bv.Velocity = Vector3.zero
				return
			end

			-- Camera-relative planar vectors
			local cf = Camera.CFrame
			local forward = Vector3.new(cf.LookVector.X, 0, cf.LookVector.Z)
			local right = Vector3.new(cf.RightVector.X, 0, cf.RightVector.Z)

			local planar = Vector3.zero
			if forward.Magnitude > 0 then planar += forward.Unit * (-move.Z) end
			if right.Magnitude > 0 then planar += right.Unit * (move.X) end

			if planar.Magnitude > 1 then planar = planar.Unit end
			planar *= FlySpeed

			local vy = 0
			if keys.Up then vy += VerticalSpeed end
			if keys.Down then vy -= VerticalSpeed end

			bv.Velocity = Vector3.new(planar.X, vy, planar.Z)
			bg.CFrame = CFrame.lookAt(root2.Position, root2.Position + cf.LookVector)
		end)
	end)
end

local function setFly(state)
	FlyEnabled = state
	if FlyEnabled then
		startFly()
	else
		cleanup()
	end
end

