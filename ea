-- =====================================================================

local function hookAutoWin(char)
	if not autoWinEnabled then return end
	if not char or char == lastCharacter then return end

	lastCharacter = char

	local hum = char:FindFirstChildOfClass("Humanoid")
	local root = getRoot(char)

	if not hum or not root then
		return
	end

	local function autoWinLoop()
		if not autoWinEnabled then return end
		if busy then return end

		-- 🚫 jangan ganggu saat ragdoll / physics
		if hum.PlatformStand then return end

		local state = hum:GetState()

		if state == Enum.HumanoidStateType.Physics
		or state == Enum.HumanoidStateType.Ragdoll
		or state == Enum.HumanoidStateType.FallingDown then
			return
		end

		busy = true

		task.spawn(function()
			local finishPos = getFinishlinePosition()

			if finishPos then
				teleportTo(finishPos)

				print("[AutoWin] Teleport Finishline")

				task.wait(5)

				local lobbyPos = getCarlobbyPosition()

				if lobbyPos then
					teleportTo(lobbyPos)

					print("[AutoWin] Teleport Carlobby")
				else
					warn("[AutoWin] Carlobby not found")
				end
			else
				warn("[AutoWin] Finishline not found")
			end

			task.wait(1)

			busy = false
		end)
	end

	-- jalan aman seperti WalkSpeed
	autoWinConn = RunService.Heartbeat:Connect(autoWinLoop)
end

local function scanCharacter()
	if not autoWinEnabled then return end

	local char = getCharacter()

	if char then
		hookAutoWin(char)
	end
end

