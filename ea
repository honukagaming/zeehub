-- ==============================
-- WINDOW DETECTION
-- ==============================
local function isWindow(inst)
	if not inst then return false end

	-- Part-based detection (Bottom / inviswall / VaultTrigger)
	if inst:IsA("BasePart") then
		local n = lower(inst.Name)
		if n == "bottom" or n == "inviswall" or n == "vaulttrigger" then
			local window = inst.Parent
			if window and lower(window.Name) == "window" then
				return true
			end
		end
	end

	-- Model-based detection
	if inst:IsA("Model") and lower(inst.Name) == "window" then
		return inst:FindFirstChild("Bottom") ~= nil
			or inst:FindFirstChild("inviswall") ~= nil
			or inst:FindFirstChild("VaultTrigger") ~= nil
	end

	return false
end

-- ==============================
