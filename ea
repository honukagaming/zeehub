-- =========================
-- NO FOG
-- =========================
local Lighting = game:GetService("Lighting")

local noFogActive = false
local removedAtmospheres = {}

local fogConnStart, fogConnEnd, fogConnColor, descAddedConn
local originalFog = {
	FogStart = Lighting.FogStart,
	FogEnd = Lighting.FogEnd,
	FogColor = Lighting.FogColor,
}

local lastFogUpdate = 0
local fogThrottle = 0.2 -- update maksimal setiap 0.2 detik

local function applyNoFog()
	Lighting.FogStart = 0
	Lighting.FogEnd = 100000
	Lighting.FogColor = Color3.fromRGB(255, 255, 255)

	for _, v in ipairs(Lighting:GetDescendants()) do
		if v:IsA("Atmosphere") then
			table.insert(removedAtmospheres, v:Clone())
			pcall(function() v:Destroy() end)
		end
	end
end

local function startAutoNoFog()
	originalFog.FogStart = Lighting.FogStart
	originalFog.FogEnd = Lighting.FogEnd
	originalFog.FogColor = Lighting.FogColor

	removedAtmospheres = {}
	applyNoFog()

	descAddedConn = Lighting.DescendantAdded:Connect(function(inst)
		if not noFogActive then return end
		pcall(function()
			if inst:IsA("Atmosphere") then
				table.insert(removedAtmospheres, inst:Clone())
				inst:Destroy()
			end
		end)
	end)

	fogConnStart = Lighting:GetPropertyChangedSignal("FogStart"):Connect(function()
		if not noFogActive then return end
		local now = tick()
		if now - lastFogUpdate < fogThrottle then return end
		lastFogUpdate = now
		pcall(function()
			if Lighting.FogStart ~= 0 then Lighting.FogStart = 0 end
		end)
	end)

	fogConnEnd = Lighting:GetPropertyChangedSignal("FogEnd"):Connect(function()
		if not noFogActive then return end
		local now = tick()
		if now - lastFogUpdate < fogThrottle then return end
		lastFogUpdate = now
		pcall(function()
			if Lighting.FogEnd ~= 100000 then Lighting.FogEnd = 100000 end
		end)
	end)

	fogConnColor = Lighting:GetPropertyChangedSignal("FogColor"):Connect(function()
		if not noFogActive then return end
		local now = tick()
		if now - lastFogUpdate < fogThrottle then return end
		lastFogUpdate = now
		pcall(function()
			if Lighting.FogColor ~= Color3.fromRGB(255,255,255) then
				Lighting.FogColor = Color3.fromRGB(255,255,255)
			end
		end)
	end)
end

local function stopAutoNoFog()
	if descAddedConn then descAddedConn:Disconnect(); descAddedConn = nil end
	if fogConnStart then fogConnStart:Disconnect(); fogConnStart = nil end
	if fogConnEnd then fogConnEnd:Disconnect(); fogConnEnd = nil end
	if fogConnColor then fogConnColor:Disconnect(); fogConnColor = nil end

	for _, clone in ipairs(removedAtmospheres) do
		pcall(function() clone.Parent = Lighting end)
	end
	removedAtmospheres = {}

	Lighting.FogStart = originalFog.FogStart
	Lighting.FogEnd = originalFog.FogEnd
	Lighting.FogColor = originalFog.FogColor
	lastFogUpdate = 0
end

