-- WalkSpeed Slider (UI)
-- ==============================
local Players = game:GetService("Players")
local LP = Players.LocalPlayer

local BASE_SPEED = 16
local MAX_SPEED = 100

local currentSpeed = BASE_SPEED
local enabled = false

local wsConn
local humConn
local stateConn
local lastHumanoid

local function clearLoop()
	if wsConn then wsConn:Disconnect(); wsConn = nil end
	if humConn then humConn:Disconnect(); humConn = nil end
	if stateConn then stateConn:Disconnect(); stateConn = nil end
	lastHumanoid = nil
end

local function hookHumanoid(hum)
	if not enabled then return end
	if not hum or hum == lastHumanoid then return end

	clearLoop()
	lastHumanoid = hum

	local function forceWS()
		if not enabled then return end
		if not hum.Parent then return end

		-- 🚫 ANTI FREEZE: jangan ganggu stun / pallet / physics
		if hum.WalkSpeed == 0 then return end
		if hum.PlatformStand then return end

		local state = hum:GetState()
		if state == Enum.HumanoidStateType.Physics
		or state == Enum.HumanoidStateType.Ragdoll
		or state == Enum.HumanoidStateType.FallingDown then
			return
		end

		local target = math.clamp(currentSpeed, BASE_SPEED + 1, MAX_SPEED)

		-- ⚠️ hanya set jika beda (anti spam)
		if hum.WalkSpeed ~= target then
			hum.WalkSpeed = target
		end
	end

	-- set sekali
	forceWS()

	-- 🔥 IY CORE (SAFE)
	wsConn = hum:GetPropertyChangedSignal("WalkSpeed"):Connect(forceWS)

	-- humanoid dihapus / diganti
	humConn = hum.AncestryChanged:Connect(function(_, parent)
		if not parent then
			clearLoop()
		end
	end)

	-- kalau masuk state stun → stop loop sementara
	stateConn = hum.StateChanged:Connect(function(_, new)
		if new == Enum.HumanoidStateType.Physics
		or new == Enum.HumanoidStateType.Ragdoll then
			clearLoop()
		end
	end)
end

local function scanHumanoid()
	if not enabled then return end

	local char = LP.Character
	if not char then return end

	local hum = char:FindFirstChildOfClass("Humanoid")
	if hum then
		hookHumanoid(hum)
	end
end

LP.CharacterAdded:Connect(function(char)
	clearLoop()
	if not enabled then return end

	local hum = char:WaitForChild("Humanoid", 5)
	if hum then
		hookHumanoid(hum)
	end

	-- rescan kalau game ganti humanoid tanpa respawn
	task.spawn(function()
		while char.Parent and enabled do
			scanHumanoid()
			task.wait(0.25)
		end
	end)
end)

-- kalau sudah spawn
if LP.Character and enabled then
	scanHumanoid()
end

