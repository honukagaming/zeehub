-- ==============================
local function mark(inst)
	if not enabled then return end
	if not inst or not inst.Parent then return end

	-- jika yang terdeteksi part → naik ke Model Window
	local target = inst
	if inst:IsA("BasePart") then
		target = inst.Parent
	end

	if not target or highlights[target] then return end
	if not isWindow(inst) then return end

	pcall(function()
		local hl = Instance.new("Highlight")
		hl.Name = "WindowESP"
		hl.Adornee = target
		hl.FillColor = neonGreen
		hl.OutlineColor = neonGreen
		hl.FillTransparency = 0.5
		hl.OutlineTransparency = 0
		hl.Parent = target

